And(varTeamLoadState="Loaded",
Coalesce(varSelectionLoaded,false),
Coalesce(varSelectionKeysValid,false),
!Coalesce(varSelectionBusy,false),
!Coalesce(varSaving,false),
IsEmpty(colSelectionLoadErrors),
!IsBlank(ddProject.Selected.Id),
!IsBlank(ddTeam.Selected.Value),
varTeamLoadedProjectID=ddProject.Selected.Id,
varTeamLoadedTeam=ddTeam.Selected.Value,
CountRows(colCurrentTeamAssignments)=varTeamLoadedAssignmentCount,
CountRows(colTeamOriginalSelection)=varTeamLoadedAssignmentCount,
CountIf(colCurrentTeamAssignments,Project.Id<>varTeamLoadedProjectID || Team.Value<>varTeamLoadedTeam || Active<>true)=0,
!IsEmpty(colSelectedWorkers),
CountIf(colSelectedWorkers,IsBlank(ID))=0,
CountRows(Distinct(colSelectedWorkers,ID))=CountRows(colSelectedWorkers),
CountIf(colTeamOriginalSelection,!(ID in ShowColumns(colSelectedWorkers,ID)) && !(ID in ShowColumns(colTeamRemovedIDs,WorkerID)))=0)
