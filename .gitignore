# Built apps
*.msapp

# Build/test output in artifacts: ignore all subfolders, keep top-level scripts and small text/config files
artifacts/*/

# Folder-copy checkpoints (replaced by git commits)
checkpoints/

# Fonts
fonts/
*.ttf
*.otf
*.woff
*.woff2
*.eot

# Data, documents, images
*.csv
*.pdf
*.png
*.jpg
*.jpeg

# Monitor / trace exports
PowerAppsTraceEvents*.json
*.trace.json
*Monitor*.json
*Monitor*.zip

# Downloads / OS junk
*.crdownload
Thumbs.db
desktop.ini

# Local Power Platform CLI copy (binaries, logs)
pac/

# Secrets never belong in the repo
github-recovery-codes*.txt

# Logo bank: only Assets/GEA_logo_white.svg is tracked (official file, unmodified). Print/claim/CMYK files and the bank archive stay local.
Assets/all.zip
Assets/*.ai
Assets/*.eps
Assets/GEA_Logo_w_Claim_*

# Studio downloads handed in by Eddy (may contain signed URLs); never commit
Incoming/
