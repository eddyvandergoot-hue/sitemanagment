And(varWeekLoadState="Loaded",
Coalesce(varWeekReady,false),
!Coalesce(varWeekKeyIssue,true),
!Coalesce(varWeekLoading,false),
!Coalesce(varWeekSaving,false),
IsEmpty(colWeekLoadErrors),
!IsBlank(varLoadedWeekMonday),
!IsBlank(varWeekLoadedProjectID),
!IsBlank(varWeekLoadedTeam),
varWeekLoadedProjectID=varProject.Id,
varWeekLoadedProjectID=ddProject.Selected.Id,
varWeekLoadedTeam=varTeam.Value,
varWeekLoadedTeam=ddTeam.Selected.Value,
varWeekLoadedISOYear=Value(ddHoursYear.Selected.Value),
varWeekLoadedKW=Value(ddHoursWeek.Selected.Value),
!IsEmpty(colWeekRows),
CountRows(colWeekRows)=varWeekLoadedAssignmentCount,
CountRows(colWeekOriginal)=varWeekLoadedAssignmentCount,
CountRows(colWeekAssignments)=varWeekLoadedAssignmentCount,
CountRows(Distinct(colWeekRows,ID))=varWeekLoadedAssignmentCount,
CountRows(Distinct(colWeekOriginal,ID))=varWeekLoadedAssignmentCount,
CountIf(colWeekRows,!(ID in ShowColumns(colWeekOriginal,ID)) || !(ID in ShowColumns(colWeekAssignments,ID)) || Project.Id<>varWeekLoadedProjectID || Team.Value<>varWeekLoadedTeam || Active<>true)=0,
varLoadedWeekMonday=DateAdd(Date(varWeekLoadedISOYear,1,4),1-Weekday(Date(varWeekLoadedISOYear,1,4),StartOfWeek.Monday)+7*(varWeekLoadedKW-1),TimeUnit.Days))
