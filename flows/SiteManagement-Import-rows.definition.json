{
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "SiteManagement - Import rows",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_file_is_created_in_Imports": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment",
              "table": "Imports"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewFileItems"
            },
            "authentication": "@parameters('$authentication')"
          },
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      },
      "actions": {
        "Init_Results": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Results",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {}
        },
        "FullPath": {
          "type": "Compose",
          "inputs": "@triggerOutputs()?['body/{FullPath}']",
          "runAfter": {
            "Init_Results": [
              "Succeeded"
            ]
          }
        },
        "FileName": {
          "type": "Compose",
          "inputs": "@triggerOutputs()?['body/{FilenameWithExtension}']",
          "runAfter": {
            "FullPath": [
              "Succeeded"
            ]
          }
        },
        "PathParts": {
          "type": "Query",
          "inputs": {
            "from": "@split(coalesce(triggerOutputs()?['body/{Path}'], ''), '/')",
            "where": "@not(equals(item(), ''))"
          },
          "runAfter": {
            "FileName": [
              "Succeeded"
            ]
          }
        },
        "ListName": {
          "type": "Compose",
          "inputs": "@if(equals(length(body('PathParts')), 2), last(body('PathParts')), '')",
          "runAfter": {
            "PathParts": [
              "Succeeded"
            ]
          }
        },
        "Upsert": {
          "type": "Compose",
          "inputs": "@startsWith(toLower(outputs('FileName')), 'upsert_')",
          "runAfter": {
            "ListName": [
              "Succeeded"
            ]
          }
        },
        "Stamp": {
          "type": "Compose",
          "inputs": "@{utcNow('yyyyMMdd_HHmmss')}",
          "runAfter": {
            "Upsert": [
              "Succeeded"
            ]
          }
        },
        "Check_ignore": {
          "type": "If",
          "expression": {
            "not": {
              "and": [
                {
                  "equals": [
                    "@length(body('PathParts'))",
                    2
                  ]
                },
                {
                  "equals": [
                    "@first(body('PathParts'))",
                    "Imports"
                  ]
                },
                {
                  "not": {
                    "equals": [
                      "@outputs('ListName')",
                      "Done"
                    ]
                  }
                },
                {
                  "endsWith": [
                    "@toLower(outputs('FileName'))",
                    ".csv"
                  ]
                }
              ]
            }
          },
          "actions": {
            "Ignore": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Stamp": [
              "Succeeded"
            ]
          }
        },
        "Process": {
          "type": "Scope",
          "actions": {
            "Wait_for_upload": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 15,
                  "unit": "Second"
                }
              },
              "runAfter": {}
            },
            "Get_file_content": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "path": "/@{outputs('FullPath')}",
                  "inferContentType": false,
                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetFileContentByPath"
                },
                "retryPolicy": {
                  "type": "fixed",
                  "count": 2,
                  "interval": "PT5S"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Wait_for_upload": [
                  "Succeeded"
                ]
              }
            },
            "Text": {
              "type": "Compose",
              "inputs": "@replace(replace(base64ToString(body('Get_file_content')?['$content']), decodeUriComponent('%EF%BB%BF'), ''), decodeUriComponent('%0D'), '')",
              "runAfter": {
                "Get_file_content": [
                  "Succeeded"
                ]
              }
            },
            "Lines": {
              "type": "Compose",
              "inputs": "@split(outputs('Text'), decodeUriComponent('%0A'))",
              "runAfter": {
                "Text": [
                  "Succeeded"
                ]
              }
            },
            "Fields": {
              "type": "Select",
              "inputs": {
                "from": "@split(first(outputs('Lines')), ';')",
                "select": "@if(equals(trim(item()), 'Key'), 'Title', trim(item()))"
              },
              "runAfter": {
                "Lines": [
                  "Succeeded"
                ]
              }
            },
            "Rows": {
              "type": "Query",
              "inputs": {
                "from": "@skip(outputs('Lines'), 1)",
                "where": "@not(equals(trim(item()), ''))"
              },
              "runAfter": {
                "Fields": [
                  "Succeeded"
                ]
              }
            },
            "HeaderOK": {
              "type": "Compose",
              "inputs": "@and(contains(createArray('Translations', 'AppSettings', 'Customers', 'ProjectSafety'), outputs('ListName')), contains(body('Fields'), 'Title'), or(not(equals(outputs('ListName'), 'Translations')), contains(body('Fields'), 'Language')))",
              "runAfter": {
                "Rows": [
                  "Succeeded"
                ]
              }
            },
            "Field_index": {
              "type": "Select",
              "inputs": {
                "from": "@range(0, length(body('Fields')))",
                "select": {
                  "I": "@item()",
                  "N": "@body('Fields')[item()]"
                }
              },
              "runAfter": {
                "HeaderOK": [
                  "Succeeded"
                ]
              }
            },
            "Title_pos": {
              "type": "Query",
              "inputs": {
                "from": "@body('Field_index')",
                "where": "@equals(item()?['N'], 'Title')"
              },
              "runAfter": {
                "Field_index": [
                  "Succeeded"
                ]
              }
            },
            "Language_pos": {
              "type": "Query",
              "inputs": {
                "from": "@body('Field_index')",
                "where": "@equals(item()?['N'], 'Language')"
              },
              "runAfter": {
                "Title_pos": [
                  "Succeeded"
                ]
              }
            },
            "Index_title": {
              "type": "Compose",
              "inputs": "@coalesce(first(body('Title_pos'))?['I'], 0)",
              "runAfter": {
                "Language_pos": [
                  "Succeeded"
                ]
              }
            },
            "Index_language": {
              "type": "Compose",
              "inputs": "@coalesce(first(body('Language_pos'))?['I'], 0)",
              "runAfter": {
                "Index_title": [
                  "Succeeded"
                ]
              }
            },
            "Get_all_existing": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/GetByTitle('@{outputs('ListName')}')/items?$select=@{if(equals(outputs('ListName'), 'Translations'), 'Id,Title,Language', 'Id,Title')}&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "retryPolicy": {
                  "type": "fixed",
                  "count": 2,
                  "interval": "PT5S"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Index_language": [
                  "Succeeded"
                ]
              }
            },
            "Existing": {
              "type": "Select",
              "inputs": {
                "from": "@coalesce(body('Get_all_existing')?['value'], createArray())",
                "select": {
                  "Id": "@item()?['Id']",
                  "K": "@toLower(concat(trim(coalesce(item()?['Title'], '')), '|', if(equals(outputs('ListName'), 'Translations'), trim(coalesce(item()?['Language'], '')), '')))"
                }
              },
              "runAfter": {
                "Get_all_existing": [
                  "Succeeded"
                ]
              }
            },
            "File_keys": {
              "type": "Select",
              "inputs": {
                "from": "@if(outputs('HeaderOK'), body('Rows'), createArray())",
                "select": "@toLower(concat(trim(coalesce(first(skip(split(item(), ';'), outputs('Index_title'))), '')), '|', if(equals(outputs('ListName'), 'Translations'), trim(coalesce(first(skip(split(item(), ';'), outputs('Index_language'))), '')), '')))"
              },
              "runAfter": {
                "Existing": [
                  "Succeeded"
                ]
              }
            },
            "More_than_5000": {
              "type": "Compose",
              "inputs": "@or(not(empty(coalesce(body('Get_all_existing')?['odata.nextLink'], body('Get_all_existing')?['@odata.nextLink'], ''))), greaterOrEquals(length(coalesce(body('Get_all_existing')?['value'], createArray())), 5000))",
              "runAfter": {
                "File_keys": [
                  "Succeeded"
                ]
              }
            },
            "Duplicate_keys_in_file": {
              "type": "Compose",
              "inputs": "@not(equals(length(union(body('File_keys'), body('File_keys'))), length(body('File_keys'))))",
              "runAfter": {
                "More_than_5000": [
                  "Succeeded"
                ]
              }
            },
            "Can_process": {
              "type": "Compose",
              "inputs": "@and(outputs('HeaderOK'), not(outputs('More_than_5000')), not(outputs('Duplicate_keys_in_file')))",
              "runAfter": {
                "Duplicate_keys_in_file": [
                  "Succeeded"
                ]
              }
            },
            "Result_header": {
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "Results",
                "value": "@if(outputs('Can_process'), '', concat('-;-;ERROR;not processed: ', if(not(outputs('HeaderOK')), 'list not allowed or header without Title (Translations: Key/Title + Language)', if(outputs('More_than_5000'), 'list has more than 5000 rows', 'duplicate keys in file')), ': ', first(outputs('Lines'))))"
              },
              "runAfter": {
                "Can_process": [
                  "Succeeded"
                ]
              }
            },
            "Apply_to_each_row": {
              "type": "Foreach",
              "foreach": "@if(outputs('Can_process'), body('Rows'), createArray())",
              "actions": {
                "Row": {
                  "type": "Scope",
                  "actions": {
                    "Parts": {
                      "type": "Compose",
                      "inputs": "@split(items('Apply_to_each_row'), ';')",
                      "runAfter": {}
                    },
                    "Form_values": {
                      "type": "Select",
                      "inputs": {
                        "from": "@range(0, length(body('Fields')))",
                        "select": {
                          "FieldName": "@body('Fields')[item()]",
                          "FieldValue": "@if(equals(item(), sub(length(body('Fields')), 1)), join(skip(outputs('Parts'), item()), ';'), if(or(equals(body('Fields')[item()], 'Title'), equals(body('Fields')[item()], 'Language')), trim(coalesce(first(skip(outputs('Parts'), item())), '')), coalesce(first(skip(outputs('Parts'), item())), '')))"
                        }
                      },
                      "runAfter": {
                        "Parts": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Row_info": {
                      "type": "Compose",
                      "inputs": {
                        "Title": "@trim(coalesce(first(skip(outputs('Parts'), outputs('Index_title'))), ''))",
                        "Lang": "@if(equals(outputs('ListName'), 'Translations'), trim(coalesce(first(skip(outputs('Parts'), outputs('Index_language'))), '')), '')",
                        "Key": "@toLower(concat(trim(coalesce(first(skip(outputs('Parts'), outputs('Index_title'))), '')), '|', if(equals(outputs('ListName'), 'Translations'), trim(coalesce(first(skip(outputs('Parts'), outputs('Index_language'))), '')), '')))",
                        "Error": "@if(less(length(outputs('Parts')), length(body('Fields'))), concat('column count ', string(length(outputs('Parts'))), ' < header'), if(or(equals(trim(coalesce(first(skip(outputs('Parts'), outputs('Index_title'))), '')), ''), and(equals(outputs('ListName'), 'Translations'), equals(trim(coalesce(first(skip(outputs('Parts'), outputs('Index_language'))), '')), ''))), 'empty key', ''))"
                      },
                      "runAfter": {
                        "Form_values": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Matches": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Existing')",
                        "where": "@equals(item()?['K'], outputs('Row_info')?['Key'])"
                      },
                      "runAfter": {
                        "Row_info": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Switch_action": {
                      "type": "Switch",
                      "expression": "@if(not(equals(outputs('Row_info')?['Error'], '')), 'ERROR', if(equals(length(body('Matches')), 0), 'ADD', if(equals(length(body('Matches')), 1), if(outputs('Upsert'), 'UPDATE', 'EXISTS'), 'DUPLICATE')))",
                      "cases": {
                        "Case_add": {
                          "case": "ADD",
                          "actions": {
                            "Create_item": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "parameters/method": "POST",
                                  "parameters/uri": "_api/web/lists/GetByTitle('@{outputs('ListName')}')/AddValidateUpdateItemUsingPath",
                                  "parameters/headers": {
                                    "Accept": "application/json;odata=nometadata",
                                    "Content-Type": "application/json;odata=nometadata"
                                  },
                                  "parameters/body": "@{json(concat('{\"formValues\":', string(body('Form_values')), ',\"bNewDocumentUpdate\":false}'))}",
                                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "HttpRequest"
                                },
                                "retryPolicy": {
                                  "type": "fixed",
                                  "count": 2,
                                  "interval": "PT5S"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "Create_errors": {
                              "type": "Query",
                              "inputs": {
                                "from": "@coalesce(body('Create_item')?['value'], createArray())",
                                "where": "@equals(item()?['HasException'], true)"
                              },
                              "runAfter": {
                                "Create_item": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Result_add": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "Results",
                                "value": "@concat(outputs('Row_info')?['Title'], ';', outputs('Row_info')?['Lang'], ';', if(greater(length(body('Create_errors')), 0), concat('ERROR;', first(body('Create_errors'))?['FieldName'], ': ', first(body('Create_errors'))?['ErrorMessage']), concat('ADDED;id ', string(first(body('Create_item')?['value'])?['ItemId']))))"
                              },
                              "runAfter": {
                                "Create_errors": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        },
                        "Case_update": {
                          "case": "UPDATE",
                          "actions": {
                            "Update_item": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "parameters/method": "POST",
                                  "parameters/uri": "_api/web/lists/GetByTitle('@{outputs('ListName')}')/items(@{string(first(body('Matches'))?['Id'])})/ValidateUpdateListItem",
                                  "parameters/headers": {
                                    "Accept": "application/json;odata=nometadata",
                                    "Content-Type": "application/json;odata=nometadata"
                                  },
                                  "parameters/body": "@{json(concat('{\"formValues\":', string(body('Form_values')), ',\"bNewDocumentUpdate\":false}'))}",
                                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "HttpRequest"
                                },
                                "retryPolicy": {
                                  "type": "fixed",
                                  "count": 2,
                                  "interval": "PT5S"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "Update_errors": {
                              "type": "Query",
                              "inputs": {
                                "from": "@coalesce(body('Update_item')?['value'], createArray())",
                                "where": "@equals(item()?['HasException'], true)"
                              },
                              "runAfter": {
                                "Update_item": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Result_update": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "Results",
                                "value": "@concat(outputs('Row_info')?['Title'], ';', outputs('Row_info')?['Lang'], ';', if(greater(length(body('Update_errors')), 0), concat('ERROR;', first(body('Update_errors'))?['FieldName'], ': ', first(body('Update_errors'))?['ErrorMessage']), concat('UPDATED;id ', string(first(body('Matches'))?['Id']))))"
                              },
                              "runAfter": {
                                "Update_errors": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        },
                        "Case_exists": {
                          "case": "EXISTS",
                          "actions": {
                            "Result_exists": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "Results",
                                "value": "@concat(outputs('Row_info')?['Title'], ';', outputs('Row_info')?['Lang'], ';', 'EXISTS;id ', string(first(body('Matches'))?['Id']))"
                              },
                              "runAfter": {}
                            }
                          }
                        },
                        "Case_duplicate": {
                          "case": "DUPLICATE",
                          "actions": {
                            "Result_duplicate": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "Results",
                                "value": "@concat(outputs('Row_info')?['Title'], ';', outputs('Row_info')?['Lang'], ';', 'DUPLICATE;ids ', string(body('Matches')), ' (not changed)')"
                              },
                              "runAfter": {}
                            }
                          }
                        }
                      },
                      "default": {
                        "actions": {
                          "Result_error": {
                            "type": "AppendToArrayVariable",
                            "inputs": {
                              "name": "Results",
                              "value": "@concat(outputs('Row_info')?['Title'], ';', outputs('Row_info')?['Lang'], ';', 'ERROR;', outputs('Row_info')?['Error'], ': ', items('Apply_to_each_row'))"
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "Matches": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Result_row_failed": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Results",
                    "value": "@concat('-;-;ERROR;request failed (see run history): ', items('Apply_to_each_row'))"
                  },
                  "runAfter": {
                    "Row": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "runAfter": {
                "Result_header": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Check_ignore": [
              "Succeeded"
            ]
          }
        },
        "Result_process_failed": {
          "type": "AppendToArrayVariable",
          "inputs": {
            "name": "Results",
            "value": "@concat('-;-;ERROR;process failed (see run history): ', coalesce(outputs('FileName'), ''))"
          },
          "runAfter": {
            "Process": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Result_lines": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@not(equals(item(), ''))"
          },
          "runAfter": {
            "Result_process_failed": [
              "Succeeded",
              "Skipped"
            ]
          }
        },
        "Count_added": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@contains(item(), ';ADDED;')"
          },
          "runAfter": {
            "Result_lines": [
              "Succeeded"
            ]
          }
        },
        "Count_updated": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@contains(item(), ';UPDATED;')"
          },
          "runAfter": {
            "Count_added": [
              "Succeeded"
            ]
          }
        },
        "Count_exists": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@contains(item(), ';EXISTS;')"
          },
          "runAfter": {
            "Count_updated": [
              "Succeeded"
            ]
          }
        },
        "Count_duplicate": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@contains(item(), ';DUPLICATE;')"
          },
          "runAfter": {
            "Count_exists": [
              "Succeeded"
            ]
          }
        },
        "Count_error": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@contains(item(), ';ERROR;')"
          },
          "runAfter": {
            "Count_duplicate": [
              "Succeeded"
            ]
          }
        },
        "Write_result": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "folderPath": "/Imports/Done",
              "name": "@{outputs('Stamp')}_@{outputs('FileName')}.result.csv",
              "body": "@{concat(decodeUriComponent('%EF%BB%BF'), 'Summary;List=', outputs('ListName'), ';File=', outputs('FileName'), ';Mode=', if(outputs('Upsert'), 'upsert', 'add-only'), ';Rows=', string(length(body('Rows'))), ';Added=', string(length(body('Count_added'))), ';Updated=', string(length(body('Count_updated'))), ';Exists=', string(length(body('Count_exists'))), ';Duplicates=', string(length(body('Count_duplicate'))), ';Errors=', string(length(body('Count_error'))), decodeUriComponent('%0A'), 'Key;Language;Result;Detail', decodeUriComponent('%0A'), join(body('Result_lines'), decodeUriComponent('%0A')))}",
              "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "CreateFile"
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 2,
              "interval": "PT5S"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Count_error": [
              "Succeeded"
            ]
          }
        },
