{
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "SiteManagement - Import rows",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_file_is_created_in_Imports": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment",
              "table": "Imports"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewFileItems"
            },
            "authentication": "@parameters('$authentication')"
          },
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      },
      "actions": {
        "Init_Log": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Log",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {}
        },
        "Init_RowResult": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "RowResult",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Init_Log": [
              "Succeeded"
            ]
          }
        },
        "FullPath": {
          "type": "Compose",
          "inputs": "@triggerOutputs()?['body/{FullPath}']",
          "runAfter": {
            "Init_RowResult": [
              "Succeeded"
            ]
          }
        },
        "FileName": {
          "type": "Compose",
          "inputs": "@triggerOutputs()?['body/{FilenameWithExtension}']",
          "runAfter": {
            "FullPath": [
              "Succeeded"
            ]
          }
        },
        "PathParts": {
          "type": "Query",
          "inputs": {
            "from": "@split(coalesce(triggerOutputs()?['body/{Path}'], ''), '/')",
            "where": "@not(equals(item(), ''))"
          },
          "runAfter": {
            "FileName": [
              "Succeeded"
            ]
          }
        },
        "ListName": {
          "type": "Compose",
          "inputs": "@if(equals(length(body('PathParts')), 2), last(body('PathParts')), '')",
          "runAfter": {
            "PathParts": [
              "Succeeded"
            ]
          }
        },
        "Upsert": {
          "type": "Compose",
          "inputs": "@startsWith(toLower(outputs('FileName')), 'upsert_')",
          "runAfter": {
            "ListName": [
              "Succeeded"
            ]
          }
        },
        "Stamp": {
          "type": "Compose",
          "inputs": "@{utcNow('yyyyMMdd_HHmmss')}",
          "runAfter": {
            "Upsert": [
              "Succeeded"
            ]
          }
        },
        "Check_ignore": {
          "type": "If",
          "expression": {
            "not": {
              "and": [
                {
                  "equals": [
                    "@length(body('PathParts'))",
                    2
                  ]
                },
                {
                  "equals": [
                    "@first(body('PathParts'))",
                    "Imports"
                  ]
                },
                {
                  "not": {
                    "equals": [
                      "@outputs('ListName')",
                      "Done"
                    ]
                  }
                },
                {
                  "endsWith": [
                    "@toLower(outputs('FileName'))",
                    ".csv"
                  ]
                }
              ]
            }
          },
          "actions": {
            "Ignore": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Stamp": [
              "Succeeded"
            ]
          }
        },
        "Process": {
          "type": "Scope",
          "actions": {
            "Wait_for_upload": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 15,
                  "unit": "Second"
                }
              },
              "runAfter": {}
            },
            "Get_file_content": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "path": "/@{outputs('FullPath')}",
                  "inferContentType": false,
                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetFileContentByPath"
                },
                "retryPolicy": {
                  "type": "fixed",
                  "count": 2,
                  "interval": "PT5S"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Wait_for_upload": [
                  "Succeeded"
                ]
              }
            },
            "Text": {
              "type": "Compose",
              "inputs": "@replace(replace(base64ToString(body('Get_file_content')?['$content']), decodeUriComponent('%EF%BB%BF'), ''), decodeUriComponent('%0D'), '')",
              "runAfter": {
                "Get_file_content": [
                  "Succeeded"
                ]
              }
            },
            "Lines": {
              "type": "Compose",
              "inputs": "@split(outputs('Text'), decodeUriComponent('%0A'))",
              "runAfter": {
                "Text": [
                  "Succeeded"
                ]
              }
            },
            "Fields": {
              "type": "Select",
              "inputs": {
                "from": "@split(first(outputs('Lines')), ';')",
                "select": "@if(equals(trim(item()), 'Key'), 'Title', trim(item()))"
              },
              "runAfter": {
                "Lines": [
                  "Succeeded"
                ]
              }
            },
            "Rows": {
              "type": "Query",
              "inputs": {
                "from": "@skip(outputs('Lines'), 1)",
                "where": "@not(equals(trim(item()), ''))"
              },
              "runAfter": {
                "Fields": [
                  "Succeeded"
                ]
              }
            },
            "HeaderOK": {
              "type": "Compose",
              "inputs": "@and(contains(createArray('Translations', 'AppSettings', 'Customers', 'ProjectSafety'), outputs('ListName')), contains(body('Fields'), 'Title'), or(not(equals(outputs('ListName'), 'Translations')), contains(body('Fields'), 'Language')))",
              "runAfter": {
                "Rows": [
                  "Succeeded"
                ]
              }
            },
            "Log_header": {
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "Log",
                "value": "@{if(outputs('HeaderOK'), '', concat('-;-;ERROR;list not allowed or header without Title (Translations: Key/Title + Language): ', first(outputs('Lines')), decodeUriComponent('%0A')))}"
              },
              "runAfter": {
                "HeaderOK": [
                  "Succeeded"
                ]
              }
            },
            "Apply_to_each_row": {
              "type": "Foreach",
              "foreach": "@if(outputs('HeaderOK'), body('Rows'), createArray())",
              "actions": {
                "Row": {
                  "type": "Scope",
                  "actions": {
                    "Parts": {
                      "type": "Compose",
                      "inputs": "@split(items('Apply_to_each_row'), ';')",
                      "runAfter": {}
                    },
                    "Form_values": {
                      "type": "Select",
                      "inputs": {
                        "from": "@range(0, length(body('Fields')))",
                        "select": {
                          "FieldName": "@body('Fields')[item()]",
                          "FieldValue": "@if(greaterOrEquals(item(), length(outputs('Parts'))), '', if(equals(item(), sub(length(body('Fields')), 1)), join(skip(outputs('Parts'), item()), ';'), outputs('Parts')[item()]))"
                        }
                      },
                      "runAfter": {
                        "Parts": [
                          "Succeeded"
                        ]
                      }
                    },
                    "FV_title": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Form_values')",
                        "where": "@equals(item()?['FieldName'], 'Title')"
                      },
                      "runAfter": {
                        "Form_values": [
                          "Succeeded"
                        ]
                      }
                    },
                    "FV_language": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Form_values')",
                        "where": "@equals(item()?['FieldName'], 'Language')"
                      },
                      "runAfter": {
                        "FV_title": [
                          "Succeeded"
                        ]
                      }
                    },
                    "TitleVal": {
                      "type": "Compose",
                      "inputs": "@trim(coalesce(first(body('FV_title'))?['FieldValue'], ''))",
                      "runAfter": {
                        "FV_language": [
                          "Succeeded"
                        ]
                      }
                    },
                    "LangVal": {
                      "type": "Compose",
                      "inputs": "@if(equals(outputs('ListName'), 'Translations'), trim(coalesce(first(body('FV_language'))?['FieldValue'], '')), '')",
                      "runAfter": {
                        "TitleVal": [
                          "Succeeded"
                        ]
                      }
                    },
                    "RowError": {
                      "type": "Compose",
                      "inputs": "@if(less(length(outputs('Parts')), length(body('Fields'))), concat('column count ', string(length(outputs('Parts'))), ' < header'), if(or(equals(outputs('TitleVal'), ''), and(equals(outputs('ListName'), 'Translations'), equals(outputs('LangVal'), ''))), 'empty key', ''))",
                      "runAfter": {
                        "LangVal": [
                          "Succeeded"
                        ]
                      }
                    },
                    "KeyFilter": {
                      "type": "Compose",
                      "inputs": "@if(equals(outputs('ListName'), 'Translations'), concat('Title eq ''', replace(outputs('TitleVal'), '''', ''''''), ''' and Language eq ''', replace(outputs('LangVal'), '''', ''''''), ''''), concat('Title eq ''', replace(outputs('TitleVal'), '''', ''''''), ''''))",
                      "runAfter": {
                        "RowError": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Get_existing": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "parameters/method": "GET",
                          "parameters/uri": "_api/web/lists/GetByTitle('@{outputs('ListName')}')/items?$select=Id&$top=10&$filter=@{encodeUriComponent(outputs('KeyFilter'))}",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata"
                          },
                          "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "retryPolicy": {
                          "type": "fixed",
                          "count": 2,
                          "interval": "PT5S"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "KeyFilter": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Existing_count": {
                      "type": "Compose",
                      "inputs": "@length(coalesce(body('Get_existing')?['value'], createArray()))",
                      "runAfter": {
                        "Get_existing": [
                          "Succeeded"
                        ]
                      }
                    },
                    "RowAction": {
                      "type": "Compose",
                      "inputs": "@if(not(equals(outputs('RowError'), '')), 'ERROR', if(equals(outputs('Existing_count'), 0), 'ADD', if(equals(outputs('Existing_count'), 1), if(outputs('Upsert'), 'UPDATE', 'EXISTS'), 'DUPLICATE')))",
                      "runAfter": {
                        "Existing_count": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Switch_action": {
                      "type": "Switch",
                      "expression": "@outputs('RowAction')",
                      "cases": {
                        "Case_add": {
                          "case": "ADD",
                          "actions": {
                            "Create_item": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "parameters/method": "POST",
                                  "parameters/uri": "_api/web/lists/GetByTitle('@{outputs('ListName')}')/AddValidateUpdateItemUsingPath",
                                  "parameters/headers": {
                                    "Accept": "application/json;odata=nometadata",
                                    "Content-Type": "application/json;odata=nometadata"
                                  },
                                  "parameters/body": "@{json(concat('{\"formValues\":', string(body('Form_values')), ',\"bNewDocumentUpdate\":false}'))}",
                                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "HttpRequest"
                                },
                                "retryPolicy": {
                                  "type": "fixed",
                                  "count": 2,
                                  "interval": "PT5S"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "Create_errors": {
                              "type": "Query",
                              "inputs": {
                                "from": "@body('Create_item')?['value']",
                                "where": "@equals(item()?['HasException'], true)"
                              },
                              "runAfter": {
                                "Create_item": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Set_result_add": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "RowResult",
                                "value": "@if(greater(length(body('Create_errors')), 0), concat('ERROR;', first(body('Create_errors'))?['FieldName'], ': ', first(body('Create_errors'))?['ErrorMessage']), concat('ADDED;id ', string(first(body('Create_item')?['value'])?['ItemId'])))"
                              },
                              "runAfter": {
                                "Create_errors": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        },
                        "Case_update": {
                          "case": "UPDATE",
                          "actions": {
                            "Update_item": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "parameters/method": "POST",
                                  "parameters/uri": "_api/web/lists/GetByTitle('@{outputs('ListName')}')/items(@{first(body('Get_existing')?['value'])?['Id']})/ValidateUpdateListItem",
                                  "parameters/headers": {
                                    "Accept": "application/json;odata=nometadata",
                                    "Content-Type": "application/json;odata=nometadata"
                                  },
                                  "parameters/body": "@{json(concat('{\"formValues\":', string(body('Form_values')), ',\"bNewDocumentUpdate\":false}'))}",
                                  "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "HttpRequest"
                                },
                                "retryPolicy": {
                                  "type": "fixed",
                                  "count": 2,
                                  "interval": "PT5S"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "Update_errors": {
                              "type": "Query",
                              "inputs": {
                                "from": "@body('Update_item')?['value']",
                                "where": "@equals(item()?['HasException'], true)"
                              },
                              "runAfter": {
                                "Update_item": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Set_result_update": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "RowResult",
                                "value": "@if(greater(length(body('Update_errors')), 0), concat('ERROR;', first(body('Update_errors'))?['FieldName'], ': ', first(body('Update_errors'))?['ErrorMessage']), concat('UPDATED;id ', string(first(body('Get_existing')?['value'])?['Id'])))"
                              },
                              "runAfter": {
                                "Update_errors": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        },
                        "Case_exists": {
                          "case": "EXISTS",
                          "actions": {
                            "Set_result_exists": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "RowResult",
                                "value": "@concat('EXISTS;id ', string(first(body('Get_existing')?['value'])?['Id']))"
                              },
                              "runAfter": {}
                            }
                          }
                        },
                        "Case_duplicate": {
                          "case": "DUPLICATE",
                          "actions": {
                            "Dup_ids": {
                              "type": "Select",
                              "inputs": {
                                "from": "@body('Get_existing')?['value']",
                                "select": "@string(item()?['Id'])"
                              },
                              "runAfter": {}
                            },
                            "Set_result_duplicate": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "RowResult",
                                "value": "@concat('DUPLICATE;ids ', join(body('Dup_ids'), ' '), ' (not changed)')"
                              },
                              "runAfter": {
                                "Dup_ids": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        }
                      },
                      "default": {
                        "actions": {
                          "Set_result_error": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "RowResult",
                              "value": "@concat('ERROR;', outputs('RowError'), ': ', items('Apply_to_each_row'))"
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "RowAction": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Log_row": {
                      "type": "AppendToStringVariable",
                      "inputs": {
                        "name": "Log",
                        "value": "@{outputs('TitleVal')};@{outputs('LangVal')};@{variables('RowResult')}@{decodeUriComponent('%0A')}"
                      },
                      "runAfter": {
                        "Switch_action": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Log_row_failed": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "Log",
                    "value": "-;-;ERROR;request failed (see run history): @{items('Apply_to_each_row')}@{decodeUriComponent('%0A')}"
                  },
                  "runAfter": {
                    "Row": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Log_header": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Check_ignore": [
              "Succeeded"
            ]
          }
        },
        "Count_added": {
          "type": "Query",
          "inputs": {
            "from": "@split(variables('Log'), decodeUriComponent('%0A'))",
            "where": "@contains(item(), ';ADDED;')"
          },
          "runAfter": {
            "Process": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Count_updated": {
          "type": "Query",
          "inputs": {
            "from": "@split(variables('Log'), decodeUriComponent('%0A'))",
            "where": "@contains(item(), ';UPDATED;')"
          },
          "runAfter": {
            "Count_added": [
              "Succeeded"
            ]
          }
        },
        "Count_exists": {
          "type": "Query",
          "inputs": {
            "from": "@split(variables('Log'), decodeUriComponent('%0A'))",
            "where": "@contains(item(), ';EXISTS;')"
          },
          "runAfter": {
            "Count_updated": [
              "Succeeded"
            ]
          }
        },
        "Count_duplicate": {
          "type": "Query",
          "inputs": {
            "from": "@split(variables('Log'), decodeUriComponent('%0A'))",
            "where": "@contains(item(), ';DUPLICATE;')"
          },
          "runAfter": {
            "Count_exists": [
              "Succeeded"
            ]
          }
        },
        "Count_error": {
          "type": "Query",
          "inputs": {
            "from": "@split(variables('Log'), decodeUriComponent('%0A'))",
            "where": "@contains(item(), ';ERROR;')"
          },
          "runAfter": {
            "Count_duplicate": [
              "Succeeded"
            ]
          }
        },
        "Write_result": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "folderPath": "/Imports/Done",
              "name": "@{outputs('Stamp')}_@{outputs('FileName')}.result.csv",
              "body": "@{concat(decodeUriComponent('%EF%BB%BF'), 'Summary;List=', outputs('ListName'), ';File=', outputs('FileName'), ';Mode=', if(outputs('Upsert'), 'upsert', 'add-only'), ';Rows=', string(length(body('Rows'))), ';Added=', string(length(body('Count_added'))), ';Updated=', string(length(body('Count_updated'))), ';Exists=', string(length(body('Count_exists'))), ';Duplicates=', string(length(body('Count_duplicate'))), ';Errors=', string(length(body('Count_error'))), decodeUriComponent('%0A'), 'Key;Language;Result;Detail', decodeUriComponent('%0A'), variables('Log'))}",
              "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "CreateFile"
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 2,
              "interval": "PT5S"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Count_error": [
              "Succeeded"
            ]
          }
        },
        "Move_to_Done": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "parameters/method": "POST",
              "parameters/uri": "_api/web/GetFileByServerRelativeUrl('/sites/GEASiteManagment/@{replace(outputs('FullPath'), '''', '''''')}')/moveto(newurl='/sites/GEASiteManagment/Imports/Done/@{replace(concat(outputs('Stamp'), '_', outputs('FileName')), '''', '''''')}',flags=1)",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata"
              },
              "dataset": "https://geacloud.sharepoint.com/sites/GEASiteManagment"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 2,
              "interval": "PT5S"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Write_result": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "flowFailureAlertSubscribed": false,
    "isManaged": false
  }
}
